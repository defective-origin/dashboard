{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "jest --detectOpenHandles",
    "prefill": "tsx ./src/prefill.ts",
    "build": "tsc --project tsconfig.production.json",
    "start": "node dist/index.js",
    "docker:build": "podman build -t server-app .",
    "docker:run": "podman run -p 3000:3000 server-app",
    "pods:up": "podman-compose up -d",
    "pods:down": "podman-compose down",
    "pods:check": "podman ps -a",
    "lint": "eslint .",
    "lint:fix": "eslint .",
    "verify": "yarn run lint && yarn run test"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "mongoose": "9.9.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/mongoose": "5.11.97",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.57.1",
    "jest": "30.5.1",
    "mongodb-memory-server": "11.2.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
