    content="DESCRIPTION"
    data-react-helmet="true"
    property="og:description"
  />
  <meta
    content="EN"
    data-react-helmet="true"
    property="og:locale"
  />
  <meta
    content="http://localhost:3000/"
    data-react-helmet="true"
    property="og:url"
  />
  <meta
    content="localhost:3000"
    data-react-helmet="true"
    property="og:site_name"
  />
  <meta
    content="ARTICLE"
    data-react-helmet="true"
    property="og:type"
  />
  <meta
    content="name1"
    data-react-helmet="true"
    name="name1"
  />
  <meta
    content="name2"
    data-react-helmet="true"
    name="name2"
  />
  <meta
    content="name3"
    data-react-helmet="true"
    name="name3"
  />
</head>
`;

