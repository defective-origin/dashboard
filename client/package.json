{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build:dev": "yarn run verify && vite build --mode development",
    "build:prod": "yarn run verify && vite build --mode production",
    "build:test": "yarn run verify && vite build --mode testing",
    "build:stage": "yarn run verify && vite build --mode staging",
    "build": "yarn run build:prod && yarn run stories:build && cp -r ./storybook-static ./dist/storybook",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:snap": "vitest run --update",
    "lint": "yarn run lint:es && yarn run lint:css && lint:deps",
    "lint:fix": "yarn run lint:es:fix && yarn run lint:css:fix",
    "lint:es": "eslint src/ --report-unused-disable-directives --max-warnings 100",
    "lint:es:fix": "eslint src/ --report-unused-disable-directives --fix",
    "lint:css": "stylelint \"src/**/*.scss\" --max-warnings 100",
    "lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint:deps": "madge --circular ./src/main.tsx",
    "verify": "yarn run lint && yarn run test",
    "gen": "plop --plopfile ./generator/generator.parts.js --dest ./src",
    "gen:init": "plop --plopfile ./generator/generator.init.js --dest ./src",
    "stories": "storybook dev -p 6006",
    "stories:build": "storybook build --docs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "@tanstack/react-query": "5.102.8",
    "axios": "1.20.0",
    "classnames": "2.5.1",
    "html-to-image": "1.11.13",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "4.0.2",
    "json-edit-react": "1.30.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-helmet-async": "3.0.0",
    "react-i18next": "17.0.13",
    "react-router-dom": "7.18.3",
    "react-toastify": "11.1.0",
    "recharts": "3.10.1",
    "vite-plugin-pwa": "1.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "1.9.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/addon-onboarding": "8.6.18",
    "@storybook/addon-themes": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/manager-api": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@storybook/theming": "8.6.18",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-plugin": "5.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-storybook": "10.6.0",
    "jsdom": "30.0.1",
    "madge": "8.0.0",
    "plop": "4.0.5",
    "sass": "1.104.0",
    "storybook": "8.6.18",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
